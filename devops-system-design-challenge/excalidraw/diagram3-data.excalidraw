    { "id": "s3-b2-label", "type": "text",
      "x": 304, "y": 542, "width": 192, "height": 165,
      "text": "Security:\nPrivate bucket\n(no public access)\n\nCloudFront OAC\n(Origin Access Control)\n→ only CF can read\n\nSSE-S3 encryption\nat rest\n\nVersioning ON\n→ protects against\n  accidental delete\n\nLifecycle rules:\n→ archive old versions",
      "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
