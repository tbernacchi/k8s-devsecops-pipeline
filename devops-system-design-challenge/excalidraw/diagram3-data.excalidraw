    { "id": "flow-title", "type": "text",
      "x": 70, "y": 762, "width": 1180, "height": 18,
      "text": "Read vs Write flow — how pods decide where to go",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#1971c2", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
