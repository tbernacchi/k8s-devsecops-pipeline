    { "id": "db-primary-title", "type": "text",
      "x": 586, "y": 170, "width": 184, "height": 18,
      "text": "Primary  (Read+Write)",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#2f9e44", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 33, "version": 1, "versionNonce": 33,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "db-primary-detail", "type": "text",
      "x": 586, "y": 194, "width": 184, "height": 505,
      "text": "AZ-1a\n\nAll WRITE ops:\nINSERT\nUPDATE\nDELETE\nTransactions\n\nAlso handles\nreads when not\noffloaded\n\nMulti-AZ Standby:\nSync replication\n→ standby in AZ-1b\n\nAuto-failover:\nif primary dies\n→ standby promoted\n< 60 seconds\n\nRPO ≈ 0\n(sync = no data loss)\n\nBackups:\nAuto daily snapshot\n+ WAL archiving\n= point-in-time recovery",
      "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 34, "version": 1, "versionNonce": 34,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },

