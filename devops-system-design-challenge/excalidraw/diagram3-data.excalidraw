    { "id": "cache-primary-title", "type": "text",
      "x": 86, "y": 170, "width": 179, "height": 18,
      "text": "Primary Node",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#c92a2a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 23, "version": 1, "versionNonce": 23,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "cache-primary-detail", "type": "text",
      "x": 86, "y": 192, "width": 179, "height": 230,
      "text": "AZ-1a\nRead + Write\n\nWhat we cache:\n• Session tokens\n• Rate limit counters\n• API responses\n• User preferences\n• Computed results\n\nTTL per key:\n• Session: 24h\n• API resp: 5min\n• Rate limit: 1min\n\nEviction:\nLRU policy",
      "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 24, "version": 1, "versionNonce": 24,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "cache-replica-box", "type": "rectangle",
      "x": 290, "y": 160, "width": 215, "height": 275,
      "strokeColor": "#e03131", "backgroundColor": "#ffc9c9",
      "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": {"type": 3}, "seed": 25, "version": 1, "versionNonce": 25,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "cache-replica-title", "type": "text",
      "x": 298, "y": 170, "width": 199, "height": 18,
      "text": "Read Replica",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#c92a2a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 26, "version": 1, "versionNonce": 26,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "cache-replica-detail", "type": "text",
      "x": 298, "y": 192, "width": 199, "height": 230,
      "text": "AZ-1b\nRead only\n\nAuto-failover:\nIf primary fails\n→ replica promoted\nto primary\n< 60 seconds\n\nSync replication\nfrom primary\n\nHA benefit:\nIf AZ-1a goes down\n→ AZ-1b takes over\n→ no data loss\n→ no cache cold start",
      "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 27, "version": 1, "versionNonce": 27,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
