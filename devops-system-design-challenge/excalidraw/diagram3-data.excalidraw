    },
    { "id": "flow-detail", "type": "text",
      "x": 70, "y": 785, "width": 1180, "height": 50,
      "text": "WRITE (INSERT/UPDATE/DELETE):  Pod  →  Redis (invalidate/update key)  →  RDS Primary  →  sync replication → standby  +  async replication → replicas\nREAD (SELECT):  Pod  →  Redis (cache hit? serve it)  →  on miss: RDS Read Replica (offload from primary)  →  write result back to Redis with TTL",
      "fontSize": 10, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 72, "version": 1, "versionNonce": 72,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },

