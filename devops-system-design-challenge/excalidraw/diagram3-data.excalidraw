    { "id": "db-rr1-title", "type": "text",
      "x": 804, "y": 170, "width": 184, "height": 18,
      "text": "Read Replica 1",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#2f9e44", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 41, "version": 1, "versionNonce": 41,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },
    { "id": "db-rr1-detail", "type": "text",
      "x": 804, "y": 194, "width": 184, "height": 505,
      "text": "AZ-1b\nRead only\n\nOffloads SELECT\nfrom primary:\n\nGood for:\n• Reports\n• Analytics\n• Dashboards\n• Search queries\n• Data exports\n\nAsync replication\nfrom primary\n(slight lag okay\nfor read workloads)\n\nRead scaling:\nAdd more replicas\n= more read throughput\n\nCan be promoted\nto primary in\nmulti-region\nfailover scenario",
      "fontSize": 9, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 42, "version": 1, "versionNonce": 42,
      "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false
    },

