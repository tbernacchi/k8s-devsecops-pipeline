    { "id": "alb-b2-label", "type": "text",
      "x": 408, "y": 815, "width": 264, "height": 80,
      "text": "Health Checks\nHTTP GET /health\nInterval: 30s\nThreshold: 2 consecutive\nUnhealthy node removed\nConnection draining: 30s",
