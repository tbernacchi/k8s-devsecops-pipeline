    { "id": "cf-b2-label", "type": "text",
      "x": 408, "y": 362, "width": 264, "height": 110,
      "text": "HTTPS + TLS\nHTTP → HTTPS redirect\nTLS 1.2 min enforced\nCustom domain + ACM cert\nHSTS header injection\nSNI support",
