    { "id": "cf-b1-label", "type": "text",
      "x": 108, "y": 362, "width": 264, "height": 110,
      "text": "Cache Behaviors\n/frontend/* → Origin: S3\n  (cached at edge)\n/backend/* → Origin: ALB\n  (no cache, dynamic)\n/assets/* → Origin: S3\n  TTL: 1 year (versioned)",
      "fontSize": 10, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#333", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "roughness": 1, "opacity": 100,
      "groupIds": [], "roundness": null, "seed": 33, "version": 1, "versionNonce": 33,
