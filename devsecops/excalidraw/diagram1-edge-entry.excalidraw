    { "id": "cf-b3-label", "type": "text",
      "x": 708, "y": 362, "width": 299, "height": 110,
      "text": "Why CDN matters\n✓ Serves from nearest PoP\n  → lower latency for all users\n✓ Shields origin from traffic spikes\n✓ Absorbs DDoS at edge\n✓ Costs less than origin compute",
